<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <ImageButton
        android:id="@+id/store_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_dark"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="centerInside"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/primary_text"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store"
        android:textColor="@color/primary_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/store_back"
        app:layout_constraintBottom_toBottomOf="@id/store_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/store_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MODRINTH  ·  CURSEFORGE"
                android:textColor="@color/secondary_text"
                android:textSize="12sp"
                android:letterSpacing="0.06"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/store_modpacks"
                style="@style/VLCreateOption"
                android:background="@drawable/bg_create_option">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Modpacks"
                    android:textColor="@color/primary_text" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Full packs" android:textColor="@color/secondary_text" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/store_mods"
                style="@style/VLCreateOption"
                android:background="@drawable/bg_create_option"
                android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Mods"
                    android:textColor="@color/primary_text" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Single mods" android:textColor="@color/secondary_text" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/store_resourcepacks"
                style="@style/VLCreateOption"
                android:background="@drawable/bg_create_option"
                android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Resource packs"
                    android:textColor="@color/primary_text" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Modrinth" android:textColor="@color/secondary_text" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/store_shaders"
                style="@style/VLCreateOption"
                android:background="@drawable/bg_create_option"
                android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Shaders"
                    android:textColor="@color/primary_text" android:textSize="15sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Modrinth" android:textColor="@color/secondary_text" android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Powered by Modrinth &amp; CurseForge APIs already in Mojo."
                android:textColor="@color/secondary_text"
                android:textSize="12sp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
