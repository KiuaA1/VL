<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/vl_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <!-- TOP: Dynamic Island (Oryn clean + your feature) -->
    <LinearLayout
        android:id="@+id/dynamic_island"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="200dp"
        android:minHeight="40dp"
        android:background="@drawable/bg_dynamic_island"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/dynamic_island_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="VL"
            android:textColor="@color/primary_text"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/dynamic_island_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/island_yes_button"
                android:layout_width="80dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_vl_button_success"
                android:text="Yes"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/island_no_button"
                android:layout_width="80dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_vl_button_danger"
                android:text="No"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Top-left brand label -->
    <TextView
        android:id="@+id/vl_brand_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VL"
        android:textColor="@color/accent_blue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/dynamic_island"/>

    <!-- Top-right action cluster (CS+ style) -->
    <LinearLayout
        android:id="@+id/top_actions"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_instance_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/dynamic_island">

        <ImageButton
            android:id="@+id/store_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Store"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_file_dl"
            app:tint="@color/primary_text"/>

        <ImageButton
            android:id="@+id/mouse_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mouse"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_mouse"
            app:tint="@color/primary_text"/>

        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_sliders"
            app:tint="@color/primary_text"/>

        <ImageButton
            android:id="@+id/account_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Account"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_px_person"
            app:tint="@color/accent_blue"/>
    </LinearLayout>

    <!-- LEFT: Skin card (Oryn-style panel) -->
    <LinearLayout
        android:id="@+id/skin_paper_container"
        android:layout_width="140dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_instance_card"
        android:elevation="3dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/dynamic_island"
        app:layout_constraintBottom_toTopOf="@id/add_instance_button"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/skin_preview"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="Player skin"/>

        <TextView
            android:id="@+id/skin_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Skin"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- RIGHT: Instances panel -->
    <TextView
        android:id="@+id/instances_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Instances"
        android:textColor="@color/primary_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/dynamic_island"
        app:layout_constraintStart_toEndOf="@id/skin_paper_container"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/instance_search"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_vl_field"
        android:hint="Search instances…"
        android:textColorHint="@color/muted_text"
        android:textColor="@color/primary_text"
        android:textSize="13sp"
        android:paddingHorizontal="14dp"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/instances_title"
        app:layout_constraintStart_toEndOf="@id/skin_paper_container"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/instances_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/instance_search"
        app:layout_constraintBottom_toTopOf="@id/add_instance_button"
        app:layout_constraintStart_toEndOf="@id/skin_paper_container"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/instances_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:gravity="center"
        android:text="No instances yet\nTap + to create one"
        android:textColor="@color/secondary_text"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/instance_search"
        app:layout_constraintBottom_toTopOf="@id/add_instance_button"
        app:layout_constraintStart_toEndOf="@id/skin_paper_container"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom center + (Oryn/CS create) -->
    <ImageButton
        android:id="@+id/add_instance_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_vl_button_primary"
        android:contentDescription="Add instance"
        android:elevation="6dp"
        android:src="@android:drawable/ic_input_add"
        android:scaleType="centerInside"
        android:padding="14dp"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
