<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/skin_back_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_dark"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/primary_text"/>

    <TextView
        android:id="@+id/skin_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Skin"
        android:textColor="@color/primary_text"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/skin_back_button"
        app:layout_constraintBottom_toBottomOf="@id/skin_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Skin preview card -->
    <FrameLayout
        android:id="@+id/skin_preview_card"
        android:layout_width="140dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_skin_paper"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/skin_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.15"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/skin_preview_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="16dp"
            android:src="@drawable/ic_px_person"
            android:contentDescription="Skin preview"/>

        <TextView
            android:id="@+id/skin_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC000000"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="Steve"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </FrameLayout>

    <!-- Account type label -->
    <TextView
        android:id="@+id/skin_account_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Local account"
        android:textColor="@color/secondary_text"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/skin_preview_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/skin_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/skin_account_type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Refresh skin -->
        <LinearLayout
            android:id="@+id/skin_refresh_button"
            style="@style/VLCreateOption"
            android:background="@drawable/bg_create_option">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh skin"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From account"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Open Laby.net -->
        <LinearLayout
            android:id="@+id/skin_laby_button"
            style="@style/VLCreateOption"
            android:background="@drawable/bg_create_option"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Browse Laby.net"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skins &amp; capes"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Open Mineskin / skin sites -->
        <LinearLayout
            android:id="@+id/skin_mineskin_button"
            style="@style/VLCreateOption"
            android:background="@drawable/bg_create_option"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View on Mineskin"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3D preview"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- Change account -->
        <LinearLayout
            android:id="@+id/skin_change_account"
            style="@style/VLCreateOption"
            android:background="@drawable/bg_create_option"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Change account"
                android:textColor="@color/primary_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch player"
                android:textColor="@color/secondary_text"
                android:textSize="13sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Hint -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Tip: Change your skin on Minecraft.net or Laby.net, then tap Refresh."
        android:textColor="@color/secondary_text"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/skin_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
