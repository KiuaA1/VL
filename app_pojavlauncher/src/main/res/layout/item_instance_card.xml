<?xml version="1.0" encoding="utf-8"?>
<!-- Dynamic Island style instance card -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instance_card_root"
    android:layout_width="wrap_content"
    android:layout_height="72dp"
    android:minWidth="200dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_instance_card"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Left: three dots (profile settings) -->
    <ImageButton
        android:id="@+id/instance_more_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_horiz"
        android:scaleType="centerInside"
        android:contentDescription="Instance settings"
        app:tint="@color/primary_text"/>

    <!-- Center: Play button -->
    <ImageButton
        android:id="@+id/instance_play_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_play_circle"
        android:src="@android:drawable/ic_media_play"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:contentDescription="Play"
        app:tint="#FFFFFF"/>

    <!-- Right: Instance image + name -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/instance_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_circle_dark"
            android:src="@drawable/ic_px_java_run"
            android:contentDescription="Instance icon"/>

        <TextView
            android:id="@+id/instance_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxWidth="110dp"
            android:text="Instance"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

</LinearLayout>
