<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/about_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start"
            android:background="@drawable/bg_circle_dark"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:tint="@color/primary_text"/>

        <ImageView
            android:id="@+id/about_logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="24dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="VL logo"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="VL"
            android:textColor="@color/primary_text"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="V LAUNCHER"
            android:textColor="@color/secondary_text"
            android:textSize="14sp"
            android:letterSpacing="0.12"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="By kiua"
            android:textColor="@color/accent_blue"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Version"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Minecraft: Java Edition launcher for Android.\nLandscape · X-style UI · Dynamic Island · Store"
            android:textColor="@color/primary_text"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="CREDITS"
            android:textColor="@color/secondary_text"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Based on MojoLauncher / PojavLauncher\nModrinth · CurseForge · mc-heads · Laby"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"/>

        <Button
            android:id="@+id/about_logs"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="28dp"
            android:background="@drawable/bg_vl_field"
            android:text="Crash logs"
            android:textAllCaps="false"
            android:textColor="@color/primary_text"/>

        <Button
            android:id="@+id/about_github"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:paddingHorizontal="28dp"
            android:background="@drawable/bg_vl_button_primary"
            android:text="GitHub"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>
</ScrollView>
